# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ─── Data (too large for git; use DVC or manual download) ────────────────────
data/
!data/.gitkeep

# ─── Model checkpoints ────────────────────────────────────────────────────────
checkpoints/
*.pt
*.pth
*.ckpt

# ─── Results / outputs ────────────────────────────────────────────────────────
results/
*.json
!configs/*.json

# ─── Jupyter notebooks — output cells only (keep source) ─────────────────────
.ipynb_checkpoints/

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Environment variables (never commit secrets) ─────────────────────────────
.env
.env.*
!.env.example

# ─── Ruff cache ───────────────────────────────────────────────────────────────
.ruff_cache/

# ─── Pytest cache ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
